# =============================================================================
# Now Playing — Environment Configuration
# Copy this file to .env and fill in the values for the services you use.
# At least one of Plex or Jellyfin must be configured.
# =============================================================================

# -----------------------------------------------------------------------------
# Plex — connect it by signing in at /setup with the setup code from the
# server logs. No token belongs here. See "Connecting Plex" in the README.
# -----------------------------------------------------------------------------

# Optional: an address for your Plex server that sign-in should try first,
# e.g. http://host.docker.internal:32400 when Plex runs on the same host
# PLEX_URL=

# Where the Plex connection is saved; put it on a persistent volume
# (default: ./data, /app/data in Docker)
# DATA_DIR=

# Recovery only: "true" clears the owner and the Plex connection at boot.
# Remove it again afterwards.
# RESET_OWNER=

# Deprecated: a Plex token instead of signing in. Anyone who can read the
# environment can use it.
# PLEX_TOKEN=

# -----------------------------------------------------------------------------
# Jellyfin (optional — remove or leave blank if not using Jellyfin)
# -----------------------------------------------------------------------------

# Full URL of your Jellyfin server, including port
JELLYFIN_URL=http://your-jellyfin-server:8096

# Jellyfin API key with admin privileges (required to list all users' history).
# Generate one in: Jellyfin Dashboard → API Keys → +
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# -----------------------------------------------------------------------------
# Spotify (optional — enables "Open in Spotify" links on music cards)
# Note: Requires a Spotify Premium account as of Feb 2026.
# -----------------------------------------------------------------------------

# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------

# Timeout for upstream API requests in milliseconds (default: 8000)
# NEXT_PUBLIC_FETCH_TIMEOUT=8000

# -----------------------------------------------------------------------------
# Status page (optional)
# -----------------------------------------------------------------------------

# Enables /status, a private page with media server health, connected viewers
# and visit stats. Leave unset to disable it (the page then returns 404).
# Generate a long random key, e.g.: openssl rand -hex 32
# STATUS_KEY=
